# backend-lite 环境变量

# LLM key 加密密钥（core/crypto.py 用）。首次启动可用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
LLM_ENCRYPTION_KEY=

# 服务监听（仅在使用 `python run.py` 启动时生效）
LITE_HOST=0.0.0.0
LITE_PORT=8090

# 上游 backend/ 目录的绝对路径（默认同级 ../backend）。仅在非标准布局下需要覆盖。
INKSIGHT_BACKEND_DIR=